# mosaic.futile.studio
#
# Caddy terminates TLS and reverse-proxies everything to the relay — including
# the WebSocket, which it upgrades on its own. Certificates are fetched and
# renewed automatically on first request.
#
# HTTPS is not optional here: Twitch refuses to embed into an insecure page, and
# the mod session cookie is SameSite=Lax on a single origin.

mosaic.futile.studio {
	encode zstd gzip

	# Clips and sounds get large. The relay enforces its own ceiling too
	# (MOSAIC_MAX_UPLOAD_BYTES); keep the two in step.
	request_body {
		max_size 512MB
	}

	reverse_proxy mosaic:4322 {
		# Long-lived WebSockets must not sit in a response buffer.
		flush_interval -1
	}
}
